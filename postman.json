  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        }
      }
    },
    {
      "name": "Metrics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/metrics",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "metrics"
          ]
        }
      }
    },
    {
      "name": "Create Notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient\": \"+905551234567\",\n  \"channel\": \"sms\",\n  \"content\": \"Your code is 1234\",\n  \"priority\": \"normal\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/notifications",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications"
          ]
        }
      }
    },
    {
      "name": "List Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications?per_page=15",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "15"
            }
          ]
        }
      }
    },
    {
      "name": "Show Notification",
      "request": {
        "method": "GET",
        "header": [
