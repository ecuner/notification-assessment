            "v1",
            "notifications",
            "{{notification_id}}",
            "retry"
          ]
        }
      }
    },
    {
      "name": "Create Notification Batch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notifications\": [\n    {\n      \"recipient\": \"+905551234567\",\n      \"channel\": \"sms\",\n      \"content\": \"Sale starts now\",\n      \"priority\": \"high\"\n    },\n    {\n      \"recipient\": \"user@example.com\",\n      \"channel\": \"email\",\n      \"content\": \"Welcome to the campaign\",\n      \"priority\": \"normal\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/notification-batches",
          "host": [
