            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "{{notification_id}}"
          ]
        }
      }
    },
    {
      "name": "Cancel Notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications/{{notification_id}}/cancel",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "{{notification_id}}",
            "cancel"
          ]
        }
      }
    },
    {
      "name": "Retry Notification",
      "request": {
        "method": "POST",
        "header": [
